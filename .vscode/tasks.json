{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start containers",
      "type": "shell",
      "command": "docker compose up -d",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Stop containers",
      "type": "shell",
      "command": "docker compose down",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
